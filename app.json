{
  "expo": {
    "name": "HitchWell",
    "slug": "hitchwell",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "hitchwell",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.page4films.hitchwell",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.page4films.hitchwell",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Reveal your income and expense amounts."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "HitchWell attaches receipt photos to your expenses.",
          "cameraPermission": "HitchWell uses the camera to capture receipt photos."
        }
      ],
      "expo-sharing",
      "expo-splash-screen",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "1c8b38fb-be03-4075-8716-10c5188e39e6"
      }
    }
  }
}
